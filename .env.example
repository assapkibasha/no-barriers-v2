# Copy to .env.local and fill in. Never commit real values.

# MongoDB Atlas connection string for the learning app (accounts, progress, activity).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
# Database name (optional, defaults to no_barriers).
MONGODB_DB=no_barriers

# Comma-separated emails that become administrators when they sign up or sign in.
# Administrators can open /admin (monitoring) and /studio/signs.
ADMIN_EMAILS=you@example.com
